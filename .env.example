# Configure as server-only environment variables. Never commit real credentials.
APP_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate recurring Stripe Price IDs keep the advertised monthly and annual
# plans aligned with Checkout. STRIPE_PRO_PRICE_ID remains a legacy monthly alias.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Optional compatibility value; Elite is not offered by the current launch UI.
STRIPE_ELITE_PRICE_ID=
# Public identity adapter requires choosing and configuring a provider before launch.
AUTH_PROVIDER=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=
# Exact verified Auth0 subject, assigned by the operator after first login.
# Never assign Owner by a client-provided email or profile field.
AUTH_OWNER_SUBJECT=
# A separate Auth0 Management API client is still required before Tradovia can
# also remove the upstream Auth0 identity when account data is deleted.
AUTH_MANAGEMENT_CLIENT_ID=
AUTH_MANAGEMENT_CLIENT_SECRET=
# Choose broker adapters and configure their server-side providers separately.
BROKER_PROVIDER=
BROKER_API_ENDPOINT=
BROKER_API_TOKEN=
# MT5 cloud: set METAAPI_TOKEN as a Cloudflare secret on both app and poller.
# Enable the app only after the poller is deployed and a real MT5 demo account passes QA.
METAAPI_TOKEN=
MT5_CLOUD_ENABLED=false
# Self-hosted Windows connector pilot. Keep disabled on the public Worker until
# an isolated host, private service token and ingest QA are ready.
MT5_BRIDGE_PILOT_ENABLED=false
# The one-time TRADOVIA_MT5_BRIDGE_TOKEN belongs only in the connector host's
# secret environment, never in this file, browser storage, or source control.
