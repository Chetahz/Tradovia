# Configure as server-only environment variables. Never commit real credentials.
APP_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
# Public identity adapter requires choosing and configuring a provider before launch.
AUTH_PROVIDER=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Choose broker adapters and configure their server-side providers separately.
BROKER_PROVIDER=
BROKER_API_ENDPOINT=
BROKER_API_TOKEN=
